# Server-only stylist provider. DeepSeek is routed through Hugging Face.
AI_PROVIDER=huggingface
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V3-0324

# Optional server-only key for Lovable text generation.
LOVABLE_API_KEY=
LOVABLE_MODEL=openai/gpt-5.6-sol

# Supabase public browser configuration.
VITE_SUPABASE_URL=
# Prefer the current Supabase publishable key; the anon key remains supported for compatibility.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Supabase server function configuration. Keep these server-only values out of VITE_* variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only Gemini key for explicit, consented try-on generation.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Local Ollama text generation. Do not expose this as VITE_*.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
